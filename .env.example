# Supabase Configuration (Browser-accessible keys MUST use NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Service Role Key (Used by /api/cron/chaser, /api/webhooks/paystack, and public pay portal APIs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=InvoiceFlow <billing@yourdomain.com>

# Public App URL & Cron Security
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-strong-random-cron-secret
